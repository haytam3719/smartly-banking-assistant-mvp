APP_ENV=local
APP_NAME=smartly-ai-banking-assistant
LOG_LEVEL=INFO
DEBUG=true

# LLM
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_ROUTER_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LLM_TIMEOUT_SECONDS=20

# Banking backend
BANKING_BACKEND_MODE=mock
BANKING_API_BASE_URL=http://banking-mock:9000
BANKING_API_TIMEOUT_SECONDS=3
BANKING_API_TOKEN=demo-token

# RAG / Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=banking-knowledge
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.55

# PostgreSQL / LangGraph persistence
DATABASE_URL=postgresql+asyncpg://banking:banking@postgres:5432/banking_ai
LANGGRAPH_POSTGRES_URI=postgresql://banking:banking@postgres:5432/banking_ai?sslmode=disable
LANGGRAPH_CHECKPOINTS_ENABLED=false
LANGGRAPH_AES_KEY=
LANGGRAPH_STRICT_MSGPACK=true

# Redis
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=120

# Observability
OTEL_ENABLED=false
OTEL_SERVICE_NAME=banking-ai-assistant
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# API guardrails
MAX_MESSAGE_CHARS=4000
MAX_TOOLS_PER_REQUEST=3
EXPOSE_DEBUG_TRACE=false
